{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
        "top": 1,
        "right": 4,
        "left": 4
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "#58B2E1",
      "title": "#1793D1"
    },
    "key": {
      "width": 20
    },
    "percent": {
      "type": 9
    }
  },

  "modules": [
    {
      "type": "title",
      "keyColor": "#1793D1"
    },
    {
      "type": "separator",
      "string": "────────────────────────────────────"
    },

    {
      "type": "custom",
      "format": "╭─ SISTEMA",
      "outputColor": "#1793D1"
    },
    {
      "type": "os",
      "key": "│    Sistema",
      "keyColor": "#58B2E1"
    },
    {
      "type": "host",
      "key": "│  󰌢  Equipo",
      "keyColor": "#58B2E1"
    },
    {
      "type": "kernel",
      "key": "│    Kernel",
      "keyColor": "#58B2E1"
    },
    {
      "type": "uptime",
      "key": "│  󰅐  Encendido",
      "keyColor": "#58B2E1"
    },
    {
      "type": "packages",
      "key": "│  󰏖  Paquetes",
      "keyColor": "#58B2E1"
    },
    {
      "type": "shell",
      "key": "╰─   Shell",
      "keyColor": "#58B2E1"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ ESCRITORIO",
      "outputColor": "#1793D1"
    },
    {
      "type": "wm",
      "key": "│    Compositor",
      "keyColor": "#58B2E1"
    },
    {
      "type": "theme",
      "key": "│  󰉼  Tema",
      "keyColor": "#58B2E1"
    },
    {
      "type": "icons",
      "key": "│  󰀻  Iconos",
      "keyColor": "#58B2E1"
    },
    {
      "type": "font",
      "key": "│    Fuente",
      "keyColor": "#58B2E1"
    },
    {
      "type": "terminal",
      "key": "│    Terminal",
      "keyColor": "#58B2E1"
    },
    {
      "type": "terminalfont",
      "key": "╰─   Term. font",
      "keyColor": "#58B2E1"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ HARDWARE",
      "outputColor": "#1793D1"
    },
    {
      "type": "cpu",
      "key": "│  󰻠  CPU",
      "keyColor": "#58B2E1"
    },
    {
      "type": "gpu",
      "key": "│  󰍛  GPU",
      "keyColor": "#58B2E1"
    },
    {
      "type": "memory",
      "key": "│  󰑭  RAM",
      "keyColor": "#58B2E1",
      "percent": {
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": "│    Disco",
      "keyColor": "#58B2E1",
      "folders": "/",
      "percent": {
        "type": 9
      }
    },
    {
      "type": "battery",
      "key": "╰─   Batería",
      "keyColor": "#58B2E1",
      "percent": {
        "type": 9
      }
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ RED",
      "outputColor": "#1793D1"
    },
    {
      "type": "localip",
      "key": "╰─ 󰩟  IP local",
      "keyColor": "#58B2E1",
      "showIpv4": true,
      "showIpv6": false
    },

    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
