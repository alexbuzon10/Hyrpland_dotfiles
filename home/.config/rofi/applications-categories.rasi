@import "modern-dark.rasi"

window {
    width: 760px;
}

mainbox {
    spacing: 13px;
    padding: 18px;
}

entry {
    placeholder: "Buscar una categoría…";
}

listview {
    columns: 2;
    lines: 5;
    spacing: 7px;
    fixed-height: true;
}

element {
    padding: 13px 14px;
    spacing: 13px;
}

element-icon {
    size: 30px;
}

element-text {
    vertical-align: 0.5;
}
