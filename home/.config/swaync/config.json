{
    "positionX": "right",
    "positionY": "top",

    "layer": "overlay",
    "control-center-layer": "top",

    "notification-window-width": 380,
    "control-center-width": 420,
    "control-center-height": 700,

    "notification-icon-size": 48,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,

    "timeout": 6,
    "timeout-low": 3,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 150,

    "widgets": [
        "title",
        "label#notification-modes-title",
        "buttons-grid#notification-modes",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notificaciones",
            "clear-all-button": true,
            "button-text": "Limpiar"
        },

        "label#notification-modes-title": {
            "max-lines": 1,
            "text": "MODOS DE NOTIFICACIÓN"
        },

        "buttons-grid#notification-modes": {
            "buttons-per-row": 2,
            "actions": [
                {
                    "label": "No molestar",
                    "type": "toggle",
                    "active": false,
                    "command": "sh -c 'case \"$SWAYNC_TOGGLE_STATE\" in true) swaync-client --dnd-on ;; *) swaync-client --dnd-off ;; esac >/dev/null'",
                    "update-command": "swaync-client --get-dnd"
                },
                {
                    "label": "Desactivar avisos",
                    "type": "toggle",
                    "active": false,
                    "command": "__DOTFILES_HOME__/.config/swaync/notification-inhibit-toggle.sh apply",
                    "update-command": "__DOTFILES_HOME__/.config/swaync/notification-inhibit-toggle.sh status"
                }
            ]
        }
    }
}
