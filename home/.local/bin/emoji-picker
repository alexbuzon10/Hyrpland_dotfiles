import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")

from gi.repository import Gdk, GLib, Gtk, GtkLayerShell


SOCKET_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "emoji-picker.sock")
LANGUAGE = os.environ.get("EMOJI_PICKER_LANGUAGE", os.environ.get("LANG", "en")).lower()


def translated(english, spanish):
    return spanish if LANGUAGE.startswith("es") else english

CATEGORIES = (
    ("󰱱", translated("Faces & emotions", "Caras y emociones"), "emojis_smileys_emotion"),
    ("󰀉", translated("People & body", "Personas y cuerpo"), "emojis_people_body"),
    ("󰏩", translated("Animals & nature", "Animales y naturaleza"), "emojis_animals_nature"),
    ("󰉚", translated("Food & drink", "Comida y bebida"), "emojis_food_drink"),
    ("󰒸", translated("Activities", "Actividades"), "emojis_activities"),
    ("󰀝", translated("Travel & places", "Viajes y lugares"), "emojis_travel_places"),
    ("󰌵", translated("Objects", "Objetos"), "emojis_objects"),
    ("󰠱", translated("Symbols", "Símbolos"), "emojis_symbols"),
    ("󰈻", translated("Flags", "Banderas"), "emojis_flags"),
)

